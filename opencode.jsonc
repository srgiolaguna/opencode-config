{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "model": "openrouter/nex-agi/nex-n2.5-mini:free",
  "small_model": "openrouter/nex-agi/nex-n2.5-mini:free",
  "shell": "/bin/zsh",
  "autoupdate": false,
  "snapshot": true,
  "logLevel": "INFO",

  "enabled_providers": ["openrouter"],
  "provider": {
    "openrouter": {
      "options": { "apiKey": "{env:OPENROUTER_API_KEY}", "baseURL": "https://openrouter.ai/api/v1", "timeout": 45000 },
      "whitelist": [
        "nex-agi/nex-n2.5-mini:free",
        "inclusionai/ling-3.0-flash-fin:free",
        "nvidia/nemotron-3.5-lightning:free"
      ]
    }
  },

  "agent": {
    "auditor":     { "model": "openrouter/nex-agi/nex-n2.5-mini:free", "mode": "all", "permission": { "edit": "deny" }, "description": "Analiza proyectos, detecta problemas y riesgos. No modifica archivos. [FREE]" },
    "implementer": { "model": "openrouter/nex-agi/nex-n2.5-mini:free", "mode": "all", "description": "Ejecuta cambios aprobados respetando alcance y decisiones. [FREE]" },
    "optimizer":   { "model": "openrouter/nex-agi/nex-n2.5-mini:free", "mode": "all", "permission": { "edit": "deny" }, "description": "Propone optimizaciones y mejoras sin aplicarlas. [FREE]" },
    "reviewer":    { "model": "openrouter/nex-agi/nex-n2.5-mini:free", "mode": "all", "permission": { "edit": "deny" }, "description": "Valida cambios realizados y detecta errores y regresiones. [FREE]" },
    "validator":   { "model": "openrouter/nex-agi/nex-n2.5-mini:free", "mode": "all", "permission": { "edit": "deny" }, "description": "Validación rápida: lint, syntax-check, compilación. Ultra-rápido y FREE. [FREE]" }
  }
}
