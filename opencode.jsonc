{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],

  // Verificado en vivo el 17-sep-2026 CON el toolset completo de omo (no --pure).
  // Ver DOCUMENTACION.md para el porqué de cada elección y qué se descartó y por qué.
  "model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it",
  "small_model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it",
  "shell": "/bin/zsh",
  "autoupdate": false,
  "snapshot": true,
  "logLevel": "INFO",

  // openrouter va el último: cuenta sin crédito = 50 peticiones/día COMPARTIDAS entre
  // todos los modelos ":free". Úsalo solo como último recurso, nunca como principal.
  // google y opencode (zen) están activados para que salgan en "oc models" y los puedas elegir a
  // mano — pero OJO: si el modelo activo/agente principal es "google/..." y usas el toolset
  // completo de omo (el modo normal, no --pure), puede fallar con un error sobre un "enum" vacío
  // — es un bug real de omo, no tuyo. Si pasa, cambia de modelo con /model y sigue. Zen puede
  // seguir agotado hasta que te resetee la cuota (no sabemos cada cuánto lo hace).
  "enabled_providers": ["cloudflare-workers-ai", "openrouter", "google", "opencode"],
  "provider": {
    "cloudflare-workers-ai":  { "options": { "apiKey": "{env:CLOUDFLARE_API_TOKEN}", "baseURL": "https://api.cloudflare.com/client/v4/accounts/{env:CLOUDFLARE_ACCOUNT_ID}/ai/v1" } },
    "openrouter":             { "options": { "apiKey": "{env:OPENROUTER_API_KEY}", "baseURL": "https://openrouter.ai/api/v1", "timeout": 45000 } },
    "google":                 { "options": { "apiKey": "{env:GEMINI_API_KEY}" } },
    "opencode":               { "options": { "apiKey": "{env:OPENCODE_SECRET_KEY}" } },

    // Desactivados hoy (17-sep-2026) por problemas de CUENTA, no de config:
    "groq":     { "options": { "apiKey": "{env:GROQ_API_KEY}" } },
    // Cerebras: comprobado en su web (17-sep) — pide AÑADIR TARJETA para un crédito promo de 5$
    // que caduca en 30 días. No es free tier permanente, es un trial con tarjeta. No usar.
    "cerebras": { "options": { "apiKey": "{env:CEREBRAS_API_KEY}" } },
    // Mistral: su free tier oficial ("Experiment") SÍ es gratis sin tarjeta (1 req/s, 500K TPM,
    // 1B tokens/mes — confirmado en docs.mistral.ai). El 0 req/min que dio hoy no es el
    // default esperado: revisa admin.mistral.ai/plateforme/limits y la sección Billing/Plan
    // de tu workspace por si el modo "Free" no está seleccionado.
    "mistral":  { "options": { "apiKey": "{env:MISTRAL_API_KEY}" } }
    // github-copilot: ELIMINADO (17-sep) — no vale la pena sin pagar la suscripción, y con PAT no funciona.
  },

  "agent": {
    "auditor":     { "model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it", "mode": "all", "permission": { "edit": "deny" }, "description": "Analiza proyectos, detecta problemas y riesgos. No modifica archivos. [FREE]" },
    "implementer": { "model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it", "mode": "all", "description": "Ejecuta cambios aprobados respetando alcance y decisiones. [FREE]" },
    "optimizer":   { "model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it", "mode": "all", "permission": { "edit": "deny" }, "description": "Propone optimizaciones y mejoras sin aplicarlas. [FREE]" },
    "reviewer":    { "model": "openrouter/nex-agi/nex-n2.5-pro:free", "mode": "all", "permission": { "edit": "deny" }, "description": "Valida cambios realizados y detecta errores y regresiones. [FREE]" },
    "validator":   { "model": "cloudflare-workers-ai/@cf/google/gemma-4-26b-a4b-it", "mode": "all", "permission": { "edit": "deny" }, "description": "Validación rápida: lint, syntax-check, compilación. Ultra-rápido y FREE. [FREE]" }
  }
}
